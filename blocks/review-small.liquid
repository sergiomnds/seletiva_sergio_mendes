<div
  class="review"
  style="--review-name-color: {{ block.settings.name_color }}; --review-text-color: {{ block.settings.text_color }};"
  {{ block.shopify_attributes }}
>
  <div class="review__header">
    <div class="review__avatar">
      {%- if block.settings.avatar != blank -%}
        {{ block.settings.avatar | image_url: width: 128 | image_tag: alt: block.settings.name, loading: 'lazy' }}
      {%- elsif block.settings.default_avatar != 'none' -%}
        <img
          src="{{ block.settings.default_avatar | append: '.jpg' | asset_url }}"
          alt="{{ block.settings.name | escape }}"
          width="128"
          height="128"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="review__meta">
      {%- if block.settings.name != blank -%}
        <p class="review__name font-medium">{{ block.settings.name | escape }}</p>
      {%- endif -%}

      {%- if block.settings.show_rating -%}
        {%- render 'star-rating',
          rating: block.settings.rating_value,
          fill_color: block.settings.star_fill_color,
          outline_color: block.settings.star_outline_color
        -%}
      {%- endif -%}
    </div>
  </div>

  {%- if block.settings.text != blank -%}
    <p class="review__text">{{ block.settings.text | escape | newline_to_br }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .review {
    max-width: 320px;
    text-align: var(--content-align, center);
  }

  .review__header {
    display: flex;
    align-items: center;
    justify-content: var(--content-justify, center);
    gap: 10px;
    text-align: left;
  }

  .review__avatar {
    flex-shrink: 0;
    width: clamp(48px, 4.44vw, 64px);
    height: clamp(48px, 4.44vw, 64px);
    border-radius: 50%;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.2);
  }

  .review__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review__name {
    margin: 0 0 4px;
    color: var(--review-name-color);
    font-size: clamp(16px, 1.25vw, 18px);
  }

  .review__text {
    margin: clamp(16px, 2vw, 28px) 0 0;
    color: var(--review-text-color);
    font-size: clamp(14px, 1.25vw, 18px);
    line-height: 1.2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review",
  "settings": [
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Photo"
    },
    {
      "type": "select",
      "id": "default_avatar",
      "label": "Default photo",
      "info": "Used when no photo is selected",
      "options": [
        { "value": "profile-review-1", "label": "Profile 1" },
        { "value": "profile-review-2", "label": "Profile 2" },
        { "value": "none", "label": "None" }
      ],
      "default": "profile-review-1"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "John R."
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name color",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Review",
      "default": "Lorem ipsum dolor sit amet consectetur. Volutpat fames diam volutpat a. Ultricies lacinia eu cras massa odio"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Review color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating (stars)",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Filled stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "star_fill_color",
      "label": "Star fill color",
      "default": "#FFB800"
    },
    {
      "type": "color",
      "id": "star_outline_color",
      "label": "Star outline color",
      "default": "#FFB800"
    }
  ]
}
{% endschema %}
