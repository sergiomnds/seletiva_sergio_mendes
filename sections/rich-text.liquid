<div class="rich-text">
  <h2 class="rich-text__heading" style="color: {{ section.settings.heading_color }}">
    {{ section.settings.heading | escape }}
  </h2>
  <p class="rich-text__text" style="color: {{ section.settings.text_color }}">
    {{ section.settings.text | escape }}
  </p>
</div>

{% stylesheet %}
  .rich-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .rich-text__heading {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vasta Essence: Dive into Our World"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#252525"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Pellentesque cras adipiscing tempus libero vel nullam mauris tellus. Aliquam ultricestellus consequat amet, lectus aliquam est in neque."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
