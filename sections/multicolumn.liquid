<div
  class="icon-row"
  style="--text-color: {{ section.settings.text_color }}; --icon-size: {{ section.settings.icon_size }}px; --bg-color: {{ section.settings.background_color }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="icon-row__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="icon-row__list">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .icon-row {
    color: var(--text-color);
    background-color: var(--bg-color);
  }

  .icon-row__heading {
    text-align: center;
    padding-top: 50px;
  }

  .icon-row__list {
    display: flex;
    justify-content: center;
    padding-bottom: 50px;
  }

  .icon-row__list > * + * {
    border-left: 1px solid rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 749px) {
    .icon-row__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 20px;
    }
    .icon-row__list > .icon-item {
      flex: none;
      min-width: 0;
      box-sizing: border-box;
      padding: 1rem 0.5rem;
      border-left: 0;
    }
    .icon-row__list > .icon-item:nth-child(even) {
      border-left: 1px solid rgba(0, 0, 0, 0.1);
    }
    .icon-row__heading {
      font-size: clamp(24px, 6vw, 36px);
      padding-left: 1rem;
      padding-right: 1rem;
      overflow-wrap: break-word;
    }
    .icon-row__list .icon-item__icon svg,
    .icon-row__list .icon-item__icon img {
      width: clamp(48px, 14vw, var(--icon-size));
      height: clamp(48px, 14vw, var(--icon-size));
    }
    .icon-row__list .icon-item__text {
      font-size: clamp(12px, 3.4vw, 16px);
      overflow-wrap: break-word;
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Multicolumn",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Text",
      "default": "Shop Smarter, Shop With Vasta"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#252525"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 48,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F6F5F5"
    }
  ],
  "blocks": [{ "type": "icon-item" }],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "icon-item", "settings": { "icon": "truck" } },
        { "type": "icon-item", "settings": { "icon": "user-favorite" } },
        { "type": "icon-item", "settings": { "icon": "sustainability" } },
        { "type": "icon-item", "settings": { "icon": "tags" } }
      ]
    }
  ]
}
{% endschema %}
