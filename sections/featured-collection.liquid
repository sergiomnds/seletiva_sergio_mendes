<section class="featured-list">
  {%- if section.settings.heading != blank -%}
    <h2 class="featured-list__heading" style="color: {{ section.settings.text_color }};">
      {{ section.settings.heading | escape }}
    </h2>
  {%- endif -%}

  <ul class="featured-list__grid" role="list">
    {% content_for 'blocks' %}
  </ul>
</section>

{% stylesheet %}
  .featured-list {
    padding: 24px 16px;
  }

  .featured-list__heading {
    text-align: center;
    margin: 0 0 clamp(24px, 2.5vw, 36px);
  }

  .featured-list__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 275px));
    justify-content: center;
    gap: clamp(15px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 749px) {
    .featured-list__grid {
      grid-template-columns: repeat(2, minmax(0, 275px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Best Selling Products"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#252525"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating (stars)",
      "default": true
    },
    {
      "type": "color",
      "id": "star_fill_color",
      "label": "Star fill color",
      "default": "#FFB800"
    },
    {
      "type": "color",
      "id": "star_outline_color",
      "label": "Star outline color",
      "default": "#FFB800"
    }
  ],
  "blocks": [{ "type": "product-card" }],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Featured Collection",
      "blocks": [
        { "type": "product-card" },
        { "type": "product-card" },
        { "type": "product-card" },
        { "type": "product-card" }
      ]
    }
  ]
}
{% endschema %}
