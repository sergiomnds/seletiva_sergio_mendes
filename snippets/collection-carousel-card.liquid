<li class="collection-carousel__item">
  <a href="{{ collection.url }}" class="collection-carousel__card">
    {%- if collection.featured_image -%}
      {{
        collection.featured_image
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600',
          sizes: '(min-width: 990px) 20vw, 70vw',
          class: 'collection-carousel__image',
          alt: collection.title
      }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'collection-carousel__image' }}
    {%- endif -%}
    <span class="collection-carousel__title">{{ collection.title | escape }}</span>
  </a>
</li>

{% stylesheet %}
  .collection-carousel__item {
    flex: 0 0 calc((100% - var(--gap) * (var(--cols) - 1)) / var(--cols));
    scroll-snap-align: center;
  }

  .collection-carousel__card {
    position: relative;
    display: block;
    aspect-ratio: var(--card-ratio, 205 / 307);
    border-radius: var(--card-radius, 12px);
    overflow: hidden;
    text-decoration: none;
  }

  .collection-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-carousel__title {
    position: absolute;
    inset: auto 0 0;
    padding: var(--card-title-padding, 48px 0 12px);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    color: #ffffff;
    text-align: center;
    font-size: var(--card-title-size, 20px);
  }
{% endstylesheet %}
